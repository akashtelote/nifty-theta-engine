UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/callback
UPSTOX_USER_ID=your_user_id_here
UPSTOX_PASSWORD=your_password_here
UPSTOX_TOTP_SECRET=your_totp_secret_here
UPSTOX_PIN_CODE=your_pin_code_here
WEBHOOK_URL=your_webhook_url_here
MAX_CAPITAL=50000
PAPER_CAPITAL=50000

# Exit rules (PROF-006/007)
TP_RESIDUAL_CREDIT_FRACTION=0.25
SL_CREDIT_MULTIPLE=2.0
TIME_STOP_WEEKDAY=3
TIME_STOP_HOUR=15
DTE_MANAGE_THRESHOLD=-1

# Strike selection (PROF-008/009)
SHORT_PUT_TARGET_DELTA=0.18
SHORT_PUT_BASE_OTM_PCT=0.01
HEDGE_WIDTH=100
MIN_CREDIT_WIDTH_RATIO=0.12
MAX_BID_ASK_SPREAD_PCT=0.15

# VIX regime OTM (PROF-010)
VIX_MAX_THRESHOLD=25.0
VIX_LOW_THRESHOLD=13.0
VIX_ELEVATED_THRESHOLD=18.0
VIX_LOW_OTM_PCT=0.012
VIX_NORMAL_OTM_PCT=0.010
VIX_ELEVATED_OTM_PCT=0.015

# Mid-week entry (PROF-011); default Friday-only
ALLOW_MIDWEEK_ENTRY=False
MIDWEEK_ENTRY_DAYS=tue,wed,thu
MIDWEEK_VIX_MIN=16.0
MIDWEEK_VIX_MAX=22.0

# Entry fills (PROF-012)
ENTRY_USE_MID_PRICE=True
ENTRY_REQUOTE_ATTEMPTS=2
ENTRY_REQUOTE_STEP_PCT=0.25

POSTGRES_USER=wheelbot
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=wheeldb
DATABASE_URL=postgresql://wheelbot:securepassword@db:5432/wheeldb
